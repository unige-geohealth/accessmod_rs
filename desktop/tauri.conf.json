{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AccessMod",
  "identifier": "org.accessmod.accessmod6",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Physical accessibility to health services",
    "copyright": "University of Geneva",
    "license": "LGPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/accessmod"
    ],
    "resources": {
      "share/": "share/",
      "licenses/": "licenses/"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
