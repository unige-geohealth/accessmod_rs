{
  "name": "@accessmod/ui",
  "private": true,
  "version": "6.0.0-alpha.2",
  "type": "module",
  "description": "AccessMod design system: AM5-faithful tokens and components (shadcn/ui, Tailwind v4), light and dark",
  "license": "LGPL-3.0-or-later",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#ui/components/am/icons": "./src/components/am/icons.ts",
    "#ui/components/am/*": "./src/components/am/*.tsx",
    "#ui/components/ui/*": "./src/components/ui/*.tsx",
    "#ui/i18n": "./src/i18n/index.tsx",
    "#ui/lib/theme": "./src/lib/theme.tsx",
    "#ui/lib/utils": "./src/lib/utils.ts",
    "#ui/assets/*": "./src/assets/*"
  },
  "exports": {
    "./am/icons": "./src/components/am/icons.ts",
    "./am/*": "./src/components/am/*.tsx",
    "./ui/*": "./src/components/ui/*.tsx",
    "./i18n": "./src/i18n/index.tsx",
    "./theme": "./src/lib/theme.tsx",
    "./utils": "./src/lib/utils.ts",
    "./assets/*": "./src/assets/*",
    "./styles.css": "./src/styles/index.css",
    "./basemap/*": "./public/basemap/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "visual": "node scripts/visual.mjs",
    "contrast": "node scripts/contrast.mjs"
  },
  "dependencies": {
    "@fontsource/source-sans-3": "5.3.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.65.0",
    "pmtiles": "4.5.0",
    "radix-ui": "1.8.1",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0"
  },
  "peerDependencies": {
    "maplibre-gl": "5.24.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tabulator-tables": "6.7.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/tabulator-tables": "6.3.6",
    "@vitejs/plugin-react": "6.1.2",
    "maplibre-gl": "5.24.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "4.23.0",
    "tabulator-tables": "6.7.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
