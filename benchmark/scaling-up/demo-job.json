{
  "schema_version": 1,
  "dem": "../../_oracle/travel-time/demo/input/dem.tif",
  "land_cover": "../../_oracle/travel-time/demo/input/land_cover.tif",
  "population": "../../_oracle/population-correction/demo/input/population.tif",
  "facilities": { "path": "../../_oracle/travel-time/demo/input/facilities.fgb", "id_field": "cat" },
  "scenario": [
    { "class": 1, "mode": "bicycling", "speed_kmh": 6 },
    { "class": 2, "mode": "walking", "speed_kmh": 4 },
    { "class": 3, "mode": "walking", "speed_kmh": 2 },
    { "class": 1001, "mode": "motorized", "speed_kmh": 100 },
    { "class": 1002, "mode": "motorized", "speed_kmh": 80 },
    { "class": 1003, "mode": "motorized", "speed_kmh": 50 }
  ],
  "method": "anisotropic",
  "neighbourhood": 8,
  "limit_s": 7200,
  "capacities": [
    { "min": 0, "max": 1000, "label": "Other facility", "capacity": 1000 },
    { "min": 1001, "max": 2000, "label": "Small facility", "capacity": 1428 },
    { "min": 2001, "max": 4000, "label": "Medium facility", "capacity": 2858 },
    { "min": 4001, "max": 8500, "label": "Large facility", "capacity": 5715 },
    { "min": 8501, "max": 17500, "label": "Extra large facility", "capacity": 12144 },
    { "min": 17501, "max": 35700, "label": "Mega large facility", "capacity": 25000 },
    { "min": 35701, "max": 9999999, "label": "Ultra large facility", "capacity": 51000 }
  ],
  "exclusions": [ { "layer": "facilities", "buffer_m": 5000, "keep": "outside" } ],
  "suitability": [
    { "factor": "population", "layer": "population", "window_m": 1000, "weight": 1, "prefer": "high" },
    { "factor": "distance", "layer": "facilities", "weight": 1, "prefer": "high" },
    { "factor": "travel_time", "layer": { "vector": { "path": "../../_oracle/merge-land-cover/demo/input/roads.fgb" } }, "method": "isotropic", "weight": 1, "prefer": "low" }
  ],
  "max_facilities": 10,
  "max_coverage_percent": 80,
  "output_dir": "../../_shared/benchmark/scaling-up/demo/out"
}
