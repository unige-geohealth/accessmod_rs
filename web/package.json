{
  "name": "accessmod-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AccessMod web interface, served by `accessmod serve`",
  "license": "LGPL-3.0-or-later",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "gen:types": "node scripts/gen-types.mjs",
    "dev": "npm run gen:types && vite",
    "build": "npm run gen:types && tsc --noEmit && vite build",
    "check": "npm run gen:types && tsc --noEmit && biome check src scripts && vitest run",
    "format": "biome format --write src scripts",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.5",
    "maplibre-gl": "5.24.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@playwright/test": "1.64.1",
    "@types/geojson": "7946.0.16",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
