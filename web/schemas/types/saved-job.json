{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A saved job: a draft job document, possibly incomplete.",
  "properties": {
    "analysis": {
      "description": "Analysis name (`travel-time`).",
      "type": "string"
    },
    "document": {
      "description": "The job document, paths relative to the project."
    },
    "id": {
      "description": "Identifier.",
      "format": "int64",
      "type": "integer"
    },
    "name": {
      "description": "Free name.",
      "type": "string"
    },
    "updated": {
      "description": "Last change, seconds since the Unix epoch.",
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "analysis",
    "name",
    "document",
    "updated"
  ],
  "title": "SavedJob",
  "type": "object"
}
