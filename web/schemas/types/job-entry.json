{
  "$defs": {
    "RunError": {
      "description": "Why a run failed.",
      "properties": {
        "issues": {
          "description": "Every problem found.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "kind": {
          "description": "`validation`, `io`, `computation`, `cancelled` or `internal`.",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "issues"
      ],
      "type": "object"
    },
    "RunRecord": {
      "description": "A run of the project.",
      "properties": {
        "analysis": {
          "description": "Analysis name.",
          "type": "string"
        },
        "datasets": {
          "description": "Datasets it wrote.",
          "items": {
            "format": "int64",
            "type": "integer"
          },
          "type": "array"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunError"
            },
            {
              "type": "null"
            }
          ],
          "description": "Why it failed (failed and cancelled runs)."
        },
        "finished": {
          "description": "End, seconds since the Unix epoch.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "id": {
          "description": "Identifier.",
          "format": "int64",
          "type": "integer"
        },
        "job": {
          "description": "Job document, paths relative to the project."
        },
        "outcome": {
          "description": "One line summarising the result (done runs).",
          "type": [
            "string",
            "null"
          ]
        },
        "output_dir": {
          "description": "Output directory, relative to the project.",
          "type": "string"
        },
        "started": {
          "description": "Start, seconds since the Unix epoch.",
          "format": "int64",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/RunStatus",
          "description": "State."
        },
        "tags": {
          "description": "Tags of the datasets it writes.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "analysis",
        "tags",
        "job",
        "status",
        "output_dir",
        "started",
        "datasets"
      ],
      "type": "object"
    },
    "RunStatus": {
      "description": "State of a run.",
      "oneOf": [
        {
          "const": "queued",
          "description": "Waiting for its turn.",
          "type": "string"
        },
        {
          "const": "running",
          "description": "In progress.",
          "type": "string"
        },
        {
          "const": "done",
          "description": "Finished; outputs registered.",
          "type": "string"
        },
        {
          "const": "failed",
          "description": "Stopped by an error.",
          "type": "string"
        },
        {
          "const": "cancelled",
          "description": "Cancelled by the user.",
          "type": "string"
        },
        {
          "const": "interrupted",
          "description": "Stopped by a crash or restart; outputs are incomplete.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A run with its project (`GET /api/runs`).",
  "properties": {
    "name": {
      "description": "Project name.",
      "type": "string"
    },
    "project": {
      "description": "Project slug.",
      "type": "string"
    },
    "run": {
      "$ref": "#/$defs/RunRecord",
      "description": "The run."
    }
  },
  "required": [
    "project",
    "name",
    "run"
  ],
  "title": "JobEntry",
  "type": "object"
}
