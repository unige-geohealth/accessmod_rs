{
  "$defs": {
    "Check": {
      "description": "A pre-analysis.",
      "properties": {
        "analysis": {
          "description": "Analysis name.",
          "type": "string"
        },
        "client": {
          "description": "Token of the client (browser tab) that asked for it.",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunError"
            },
            {
              "type": "null"
            }
          ],
          "description": "Why it failed: the job's issues."
        },
        "id": {
          "description": "Identifier, unique while the server runs.",
          "format": "int64",
          "type": "integer"
        },
        "progress": {
          "anyOf": [
            {
              "$ref": "#/$defs/Progress"
            },
            {
              "type": "null"
            }
          ],
          "description": "Latest progress while running."
        },
        "project": {
          "description": "Project slug.",
          "type": "string"
        },
        "result": {
          "description": "The validation summary of a done one (`validate --json`)."
        },
        "status": {
          "$ref": "#/$defs/RunStatus",
          "description": "Queued, running, done, failed or cancelled."
        }
      },
      "required": [
        "id",
        "project",
        "analysis",
        "client",
        "status"
      ],
      "type": "object"
    },
    "LaneName": {
      "description": "A lane.",
      "oneOf": [
        {
          "const": "compute",
          "description": "Analyses.",
          "type": "string"
        },
        {
          "const": "io",
          "description": "Operations: archives, exports, imports.",
          "type": "string"
        },
        {
          "const": "check",
          "description": "Pre-analyses of jobs being edited.",
          "type": "string"
        }
      ]
    },
    "PendingOperation": {
      "description": "An operation making a project, while it is not recorded in it.",
      "properties": {
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunError"
            },
            {
              "type": "null"
            }
          ],
          "description": "Why it failed."
        },
        "finished": {
          "description": "End, seconds since the Unix epoch.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "id": {
          "description": "Identifier, unique while the server runs.",
          "format": "int64",
          "type": "integer"
        },
        "name": {
          "description": "Name of the project it makes.",
          "type": "string"
        },
        "operation": {
          "description": "`project-create`, `project-import` or `demo-reset`.",
          "type": "string"
        },
        "owner": {
          "description": "User who started it.",
          "type": "string"
        },
        "progress": {
          "anyOf": [
            {
              "$ref": "#/$defs/Progress"
            },
            {
              "type": "null"
            }
          ],
          "description": "Latest progress while running."
        },
        "project": {
          "description": "Slug of the project it makes.",
          "type": "string"
        },
        "started": {
          "description": "Start, seconds since the Unix epoch.",
          "format": "int64",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/RunStatus",
          "description": "Queued, running, done, failed or cancelled."
        }
      },
      "required": [
        "id",
        "operation",
        "project",
        "name",
        "owner",
        "status",
        "started"
      ],
      "type": "object"
    },
    "Progress": {
      "description": "Progress of a running analysis, reported through a [`Monitor`].\n\nStages are stable identifiers, the keys of `durations_s` in `run.json`\n(`load_inputs`, `solve`, `write_outputs`, …), so an interface can\ntranslate them. Progress never changes results.",
      "properties": {
        "done": {
          "description": "Units done in the stage (cells, searches, facilities, iterations).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "stage": {
          "description": "Stage identifier.",
          "type": "string"
        },
        "total": {
          "description": "Units in the stage, when known.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "stage",
        "done"
      ],
      "type": "object"
    },
    "QueueEntry": {
      "description": "A task waiting or running in a lane, as clients see it.",
      "properties": {
        "lane": {
          "$ref": "#/$defs/LaneName",
          "description": "Lane."
        },
        "paused": {
          "description": "Held by the user.",
          "type": "boolean"
        },
        "position": {
          "description": "0: running; 1: next; …",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "project": {
          "description": "Project slug.",
          "type": "string"
        },
        "run": {
          "description": "Run.",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "lane",
        "project",
        "run",
        "position",
        "paused"
      ],
      "type": "object"
    },
    "RunError": {
      "description": "Why a run failed.",
      "properties": {
        "issues": {
          "description": "Every problem found.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "kind": {
          "description": "`validation`, `io`, `computation`, `cancelled` or `internal`.",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "issues"
      ],
      "type": "object"
    },
    "RunKind": {
      "description": "What a run does.",
      "oneOf": [
        {
          "const": "analysis",
          "description": "An analysis: a job, inputs, outputs registered as datasets.",
          "type": "string"
        },
        {
          "const": "manage",
          "description": "An operation on the project (archive, export, import): its\n`analysis` is the operation name, its `job` the parameters.",
          "type": "string"
        }
      ]
    },
    "RunRecord": {
      "description": "A run of the project.",
      "properties": {
        "analysis": {
          "description": "Analysis name.",
          "type": "string"
        },
        "datasets": {
          "description": "Datasets it wrote.",
          "items": {
            "format": "int64",
            "type": "integer"
          },
          "type": "array"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunError"
            },
            {
              "type": "null"
            }
          ],
          "description": "Why it failed (failed and cancelled runs)."
        },
        "finished": {
          "description": "End, seconds since the Unix epoch.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "id": {
          "description": "Identifier.",
          "format": "int64",
          "type": "integer"
        },
        "inputs": {
          "description": "Datasets its job reads, still in the project.",
          "items": {
            "format": "int64",
            "type": "integer"
          },
          "type": "array"
        },
        "job": {
          "description": "Job document, paths relative to the project."
        },
        "kind": {
          "$ref": "#/$defs/RunKind",
          "default": "analysis",
          "description": "Analysis or operation."
        },
        "outcome": {
          "description": "One line summarising the result (done runs).",
          "type": [
            "string",
            "null"
          ]
        },
        "output_dir": {
          "description": "Output directory, relative to the project.",
          "type": "string"
        },
        "overwrite": {
          "default": false,
          "description": "Whether it may replace datasets of its output classes and tags.",
          "type": "boolean"
        },
        "result": {
          "description": "What a done operation made (an archive, a file, a dataset)."
        },
        "started": {
          "description": "Start, seconds since the Unix epoch.",
          "format": "int64",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/RunStatus",
          "description": "State."
        },
        "tags": {
          "description": "Tags of the datasets it writes.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "analysis",
        "tags",
        "job",
        "status",
        "output_dir",
        "started",
        "datasets",
        "inputs"
      ],
      "type": "object"
    },
    "RunStatus": {
      "description": "State of a run.",
      "oneOf": [
        {
          "const": "queued",
          "description": "Waiting for its turn.",
          "type": "string"
        },
        {
          "const": "running",
          "description": "In progress.",
          "type": "string"
        },
        {
          "const": "done",
          "description": "Finished; outputs registered.",
          "type": "string"
        },
        {
          "const": "failed",
          "description": "Stopped by an error.",
          "type": "string"
        },
        {
          "const": "cancelled",
          "description": "Cancelled by the user.",
          "type": "string"
        },
        {
          "const": "interrupted",
          "description": "Stopped by a crash or restart; outputs are incomplete.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "An event, sent as JSON with its `type` as the SSE event name.",
  "oneOf": [
    {
      "description": "A run was queued, started, finished, failed or was cancelled.",
      "properties": {
        "project": {
          "description": "Project slug.",
          "type": "string"
        },
        "run": {
          "$ref": "#/$defs/RunRecord",
          "description": "The run as it is now."
        },
        "type": {
          "const": "run",
          "type": "string"
        }
      },
      "required": [
        "type",
        "project",
        "run"
      ],
      "type": "object"
    },
    {
      "description": "Progress of a running run.",
      "properties": {
        "progress": {
          "$ref": "#/$defs/Progress",
          "description": "Stage and counts."
        },
        "project": {
          "description": "Project slug.",
          "type": "string"
        },
        "run": {
          "description": "Run identifier.",
          "format": "int64",
          "type": "integer"
        },
        "type": {
          "const": "progress",
          "type": "string"
        }
      },
      "required": [
        "type",
        "project",
        "run",
        "progress"
      ],
      "type": "object"
    },
    {
      "description": "Runs of a project were removed.",
      "properties": {
        "project": {
          "description": "Project slug.",
          "type": "string"
        },
        "type": {
          "const": "runs",
          "type": "string"
        }
      },
      "required": [
        "type",
        "project"
      ],
      "type": "object"
    },
    {
      "description": "Datasets or saved jobs of a project changed.",
      "properties": {
        "project": {
          "description": "Project slug.",
          "type": "string"
        },
        "type": {
          "const": "catalogue",
          "type": "string"
        }
      },
      "required": [
        "type",
        "project"
      ],
      "type": "object"
    },
    {
      "description": "Projects were created, renamed or deleted.",
      "properties": {
        "type": {
          "const": "projects",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    {
      "description": "An operation making a project (creation, import, demo) changed.",
      "properties": {
        "operation": {
          "$ref": "#/$defs/PendingOperation",
          "description": "The operation as it is now."
        },
        "type": {
          "const": "pending",
          "type": "string"
        }
      },
      "required": [
        "type",
        "operation"
      ],
      "type": "object"
    },
    {
      "description": "A pre-analysis changed (its client follows it).",
      "properties": {
        "check": {
          "$ref": "#/$defs/Check",
          "description": "The pre-analysis as it is now."
        },
        "type": {
          "const": "check",
          "type": "string"
        }
      },
      "required": [
        "type",
        "check"
      ],
      "type": "object"
    },
    {
      "description": "What a lane holds now: its running task, then the waiting ones.",
      "properties": {
        "entries": {
          "description": "Tasks, running first.",
          "items": {
            "$ref": "#/$defs/QueueEntry"
          },
          "type": "array"
        },
        "lane": {
          "$ref": "#/$defs/LaneName",
          "description": "Lane."
        },
        "type": {
          "const": "queue",
          "type": "string"
        }
      },
      "required": [
        "type",
        "lane",
        "entries"
      ],
      "type": "object"
    }
  ],
  "title": "Event"
}
