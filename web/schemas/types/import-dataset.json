  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`dataset.import`.",
  "properties": {
    "class": {
      "$ref": "#/$defs/DataClass",
      "description": "Data class."
    },
    "layer": {
      "default": null,
      "description": "Layer of a vector file.",
      "type": [
        "string",
        "null"
      ]
    },
    "project": {
      "description": "Project slug.",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/FileSource",
      "description": "File to import: an upload, or a file on the server's disk (desktop)."
    },
    "tags": {
      "description": "Tags naming the dataset.",
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "project",
    "source",
    "class",
    "tags"
  ],
  "title": "ImportDataset",
  "type": "object"
