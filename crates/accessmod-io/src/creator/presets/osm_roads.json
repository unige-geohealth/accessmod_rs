{
  "preset": "osm_roads",
  "version": 1,
  "status": "provisional: classes and speeds to be reviewed before release",
  "source": "OpenStreetMap (HOT export, roads lines), ODbL",
  "field": "road_class",
  "add_1000": true,
  "rules": [
    { "class": 1, "label": "Motorway and trunk", "highway": ["motorway", "motorway_link", "trunk", "trunk_link"], "mode": "motorized", "speed_kmh": 80.0 },
    { "class": 2, "label": "Primary road", "highway": ["primary", "primary_link"], "mode": "motorized", "speed_kmh": 60.0 },
    { "class": 3, "label": "Secondary road", "highway": ["secondary", "secondary_link"], "mode": "motorized", "speed_kmh": 50.0 },
    { "class": 4, "label": "Tertiary road", "highway": ["tertiary", "tertiary_link"], "mode": "motorized", "speed_kmh": 40.0 },
    { "class": 5, "label": "Local road", "highway": ["unclassified", "residential", "living_street", "service", "road"], "mode": "motorized", "speed_kmh": 30.0 },
    { "class": 6, "label": "Track", "highway": ["track"], "mode": "motorized", "speed_kmh": 15.0 },
    { "class": 7, "label": "Path", "highway": ["path", "footway", "bridleway", "cycleway", "steps", "pedestrian"], "mode": "walking", "speed_kmh": 5.0 }
  ],
  "excluded": {
    "highway": ["construction", "proposed", "abandoned", "disused", "raceway", "bus_guideway", "escape", "platform", "corridor", "elevator"],
    "access": ["no", "private"],
    "tunnel": ["yes", "building_passage", "culvert"]
  },
  "unknown": "excluded, and counted in the build report"
}
